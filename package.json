{
  "name": "openboxes-compatibility",
  "version": "0.1.0",
  "private": true,
  "description": "Black-box compatibility checks for OpenBoxes: boot a baseline and a candidate, run the same checks, compare.",
  "engines": {
    "node": ">=22 <23"
  },
  "scripts": {
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "typecheck": "tsc --noEmit",
    "test": "playwright test",
    "test:api": "playwright test --project=api",
    "test:pages": "playwright test --project=pages",
    "compare": "tsx scripts/compare.ts",
    "test:unit": "tsx --test scripts/compare.test.ts"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@playwright/test": "1.65.0",
    "@types/node": "22.20.5",
    "eslint": "9.39.5",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-playwright": "2.12.2",
    "eslint-plugin-simple-import-sort": "14.0.0",
    "prettier": "3.10.0",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.2"
  }
}
