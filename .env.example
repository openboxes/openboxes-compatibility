# Copy to .env (gitignored). Every variable is optional; defaults shown.

# Base URL of the instance under test, including the context path.
OB_BASE_URL=http://localhost:8080/openboxes
OB_ADMIN_USERNAME=admin
OB_ADMIN_PASSWORD=password
# Location chosen at login (fresh installs: 1 = Main Warehouse).
OB_LOCATION_ID=1
# Results go to results/<label>/.
OB_LABEL=local

# Used by scripts/stack.sh only.
# OB_HTTP_PORT=8080
# OB_MAILPIT_PORT=8025
# OB_BOOT_TIMEOUT_MIGRATIONS=600
# OB_STABILITY_SECONDS=15
# OB_DB_IMAGE=mariadb:10.3.39
# OB_KEEP_STACK=1
